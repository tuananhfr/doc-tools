PORT=3003
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doc_tools
DB_USER=doc_tools
DB_PASSWORD=
VISIT_HASH_SECRET=
RULE_SIGNING_PUBLIC_KEY_PEM=

# Mail: direct | smtp | log (log prints codes to the console — development only)
MAIL_TRANSPORT=log
MAIL_FROM=contact@lpc.vn
MAIL_FROM_NAME=Chuyện Nhỏ
MAIL_HELO_NAME=
MAIL_DKIM_DOMAIN=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_KEY_FILE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# Accounts; SITE_ORIGINS = comma-separated site origins allowed to write (empty = any, dev only)
SITE_ORIGINS=
COOKIE_SECURE=1
SESSION_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# GoClaw + MCP (AI phase; GoClaw runs on another server)
GOCLAW_URL=http://localhost:18790
GOCLAW_GATEWAY_TOKEN=
GOCLAW_PUBLIC_WS_URL=
GOCLAW_PUBLIC_FILES_URL=
MCP_PUBLIC_URL=
MCP_ALLOWED_IPS=
# Dev only: allow a private/LAN apiBase (e.g. Ollama). GoClaw's own SSRF check still applies.
AI_DEV_ALLOW_PRIVATE_API_BASE=0
# Chat ticket lifetime; GoClaw caps it at 1800.
AI_TICKET_TTL_SECONDS=900
