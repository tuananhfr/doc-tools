PORT=3003
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=doc_tools
DB_USER=doc_tools
DB_PASSWORD=
VISIT_HASH_SECRET=
RULE_SIGNING_PUBLIC_KEY_PEM=

# Seals the mail/GoClaw secrets an owner types into the admin area (any random string of 32+ characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`). Set it once; changing
# it makes the stored secrets unreadable, and they must be typed again. Without it the admin form saves
# only non-secret values.
CONFIG_ENCRYPTION_KEY=
# 1 = ignore the mail/GoClaw settings saved in the admin area and use only this file (way back in after a bad value).
CONFIG_FROM_ENV_ONLY=0

# Mail: direct | smtp | log (log prints codes to the console — development only). The admin area
# (Email page) overrides these once an owner saves it.
MAIL_TRANSPORT=log
MAIL_FROM=contact@lpc.vn
MAIL_FROM_NAME=Chuyện Nhỏ
MAIL_HELO_NAME=
MAIL_DKIM_DOMAIN=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_KEY_FILE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# Accounts; SITE_ORIGINS = comma-separated site origins allowed to write (empty = any, dev only)
SITE_ORIGINS=
# Public address of the site (with base path) used in links inside account mail
SITE_PUBLIC_URL=https://lpc.vn/doc-tools
COOKIE_SECURE=1
SESSION_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# GoClaw + MCP (AI phase; GoClaw runs on another server). The admin area (AI accounts page) overrides these.
GOCLAW_URL=http://localhost:18790
GOCLAW_GATEWAY_TOKEN=
GOCLAW_PUBLIC_WS_URL=
GOCLAW_PUBLIC_FILES_URL=
MCP_PUBLIC_URL=
MCP_ALLOWED_IPS=
# Dev only: allow a private/LAN apiBase (e.g. Ollama). GoClaw's own SSRF check still applies.
AI_DEV_ALLOW_PRIVATE_API_BASE=0
# Chat ticket lifetime; GoClaw caps it at 1800.
AI_TICKET_TTL_SECONDS=900
# Chat image uploads. GoClaw downloads them from AI_UPLOAD_PUBLIC_URL (base of /api/v1, must be
# public: GoClaw refuses private hosts); empty = MCP_PUBLIC_URL without /mcp/sse.
AI_UPLOAD_PUBLIC_URL=
AI_UPLOAD_DIR=
# Bytes; per file is capped at 10 MiB whatever is set here.
AI_UPLOAD_MAX_BYTES=10485760
AI_UPLOAD_DAILY_BYTES=2147483648
AI_UPLOAD_RETENTION_DAYS=7

# Pictures for the per-site intro pages (admin uploads); empty = data/landing-assets.
LANDING_ASSET_DIR=
LANDING_ASSET_MAX_BYTES=5242880
