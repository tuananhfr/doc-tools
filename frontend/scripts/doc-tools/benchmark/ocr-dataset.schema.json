{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local OCR evaluation dataset",
  "type": "object",
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "split",
          "permission",
          "groundTruth",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "synthetic",
              "real"
            ]
          },
          "split": {
            "enum": [
              "tuning",
              "holdout",
              "unassigned"
            ]
          },
          "permission": {
            "enum": [
              "generated",
              "user-authorized-local"
            ]
          },
          "writerId": {
            "type": "string"
          },
          "inputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groundTruth": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "generated",
                  "pending",
                  "human-approved"
                ]
              },
              "text": {
                "type": "string"
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "quad"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "block",
                        "line",
                        "table",
                        "form",
                        "signature",
                        "unknown"
                      ]
                    },
                    "quad": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "required": [
                          "x",
                          "y"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "text",
                        "money",
                        "date",
                        "identifier"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "quad": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "required": [
                          "x",
                          "y"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "cells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "row",
                    "column",
                    "text"
                  ],
                  "properties": {
                    "row": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "column": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rowSpan": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "columnSpan": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16
                    },
                    "text": {
                      "type": "string"
                    },
                    "quad": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "required": [
                          "x",
                          "y"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
